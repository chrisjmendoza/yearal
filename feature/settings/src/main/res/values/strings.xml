    <!-- Title of the Privacy screen. -->
    <string name="privacy_title">Privacy</string>

    <!-- Spoken description of the back arrow in the top app bar. -->
    <string name="privacy_back">Back</string>

    <!-- Section heading: the short version. -->
    <string name="privacy_section_summary">In short</string>

    <!-- The short version, close to the wording docs/security-and-privacy.md itself proposes. -->
    <string name="privacy_summary_body">Your calendar stays on your phone. Yearal has no account, no ads, no analytics and no crash-reporting service, and no server of its own. Because it has no permission to use the internet at all, the app itself cannot send your data anywhere. The one copy that can leave your phone is Android\'s own encrypted device backup, described below, which you control.</string>

    <!-- Section heading: what is stored. -->
    <string name="privacy_section_data">What is stored, and where</string>

    <!-- What the app stores (docs/security-and-privacy.md: "events, reminders, settings; stored only in
         the app's private storage on the device"). -->
    <string name="privacy_data_body">Your settings, your events and your reminders are the only things this app keeps, and they live only in the app\'s own private storage on your device — never on a server, because there is no server.</string>

    <!-- Section heading: permissions. -->
    <string name="privacy_section_permissions">Permissions, and what they\'re for</string>

    <!-- RECEIVE_BOOT_COMPLETED, the only reason it is declared today. -->
    <string name="privacy_permission_boot">Restart the day at midnight: the app asks Android for permission to run right after your device restarts (\"receive boot completed\"), only so it can re-arm the alarm that keeps the widget and the date rollover correct — a restart otherwise cancels it.</string>

    <!-- WAKE_LOCK, merged in by WorkManager for the widget. -->
    <string name="privacy_permission_wake">Keep the widget\'s date right: a system mechanism the widget\'s background updates rely on (\"wake lock\") briefly keeps the device awake long enough to redraw the widget.</string>
    <!-- Reminders (ROADMAP M6 T1, T3). Keep in step with the allow-list table in docs/security-and-privacy.md §5. -->
    <string name="privacy_permission_notifications">Show event reminders: on Android 13 and later the app asks for permission to post notifications (\"post notifications\") the first time you add a reminder to an event. If you say no, everything else keeps working; reminders are simply not shown. On the lock screen a reminder shows only \"Event reminder\" and the time, never the event\'s title.</string>
    <string name="privacy_permission_exact_alarm">Be on time: reminders and the midnight date change use an exact alarm (\"use exact alarm\", or \"schedule exact alarm\" on Android 12), so they arrive at the right minute even when the phone is idle. The app keeps a single alarm at a time. Without it everything still works, up to about ten minutes late.</string>

    <!-- What is deliberately absent. -->
    <string name="privacy_permission_none">That\'s the complete list. Yearal does not ask for your contacts, your location, your photos or files, your device calendars, or the internet.</string>

    <!-- Section heading: backups. -->
    <string name="privacy_section_backup">Backups</string>

    <!-- Backup behaviour (docs/security-and-privacy.md §4.1: encrypted-only Auto Backup). -->
    <string name="privacy_backup_body">If you have Android device backup turned on with a screen lock set, your settings and events may be included in an encrypted backup to your Google account — encrypted with your own screen lock, so Google cannot read it either. You can turn this off at any time in your device\'s system settings; the app has no separate control over it.</string>

    <!-- Section heading: the policy itself. -->
    <string name="privacy_section_policy">The full policy</string>

