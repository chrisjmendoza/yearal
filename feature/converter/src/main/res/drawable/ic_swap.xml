<?xml version="1.0" encoding="utf-8"?>
<!-- The direction-swap glyph between the two conversion directions (docs/design-plan.md §4.6): two
     opposing horizontal arrows, the same shape as :app's ic_convert.xml (the Convert tab icon) and the
     same reasoning — androidx.compose.material:material-icons-core has no swap/compare icon at all
     (only material-icons-extended does, deliberately not a dependency here, docs/ARCHITECTURE.md §1
     "Stack decisions"), and a single circular-arrow "refresh" icon was reviewed as misleading (ROADMAP
     R5). :feature:converter cannot reference :app's drawable, so this is the same glyph, redrawn
     locally. Tinted by the caller (Icon's tint), like ic_intercalary.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Top shaft, pointing right, tail at the left edge. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M4,7 L15,7 L15,5 L20,8 L15,11 L15,9 L4,9 Z" />
    <!-- Bottom shaft, pointing left, tail at the right edge. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M20,15 L9,15 L9,13 L4,16 L9,19 L9,17 L20,17 Z" />
</vector>
