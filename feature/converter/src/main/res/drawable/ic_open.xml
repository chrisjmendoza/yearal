<?xml version="1.0" encoding="utf-8"?>
<!-- The "Open day" action's leading icon (docs/design-plan.md §4.6): an open frame with an arrow
     breaking out of its top-right corner ("open elsewhere"). Material's "open in new" glyph lives only
     in material-icons-extended, which is deliberately not a dependency here (docs/ARCHITECTURE.md §1
     "Stack decisions" — see ic_convert.xml for the same reasoning), so this is a small hand-drawn
     replacement. Tinted by the caller (Icon's tint), like ic_intercalary.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The frame, open at the top-right corner so the arrow can break through it. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M5,5h7v2L7,7v10h10v-5h2v7L5,19z" />
    <!-- The arrow, pointing out and up to the right. -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M13,3h8v8h-2L19,6.4 12.7,12.7 11.3,11.3 17.6,5L13,5z" />
</vector>
