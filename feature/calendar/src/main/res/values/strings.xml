<?xml version="1.0" encoding="utf-8"?>
<!-- Strings of the Today screen (docs/FEATURES.md T1–T4, T6), the Month pager (C1, C3, C7) and its day
     card (C5). Calendar terms and date patterns live in :core:designsystem, not here. -->
<resources>

    <!-- Spoken description of the progress spinner shown until the first date tick arrives. -->
    <string name="today_loading">Loading today’s date</string>

    <!-- Eyebrow captions of the Today hero card's date pair (`docs/design-plan.md` §4.1) and the Month
         summary's date pair (§4.2): "IFC" labels the long IFC date, "Gregorian" the Gregorian long
         date. Shown in `labelSmall`, uppercased for display. Reused by both screens so the two never
         drift out of sync. -->
    <string name="eyebrow_ifc">IFC</string>
    <string name="eyebrow_gregorian">Gregorian</string>

    <!-- Joins the day-and-week text with the quarter on one line.
         %1$s = "Day 260 · Week 38 of 52", %2$s = "Q3". -->
    <string name="today_day_week_quarter">%1$s · %2$s</string>

    <!-- Shown in the Holidays card when today has none, instead of hiding the card (`docs/design-plan.md`
         §4.1: "Empty Today ... shows one quiet line inside a card, not nothing"). -->
    <string name="today_holidays_empty">No holidays today.</string>

    <!-- Shown in the Events card when today has none, for the same reason as today_holidays_empty. -->
    <string name="today_agenda_empty">Nothing on your agenda today.</string>

    <!-- Month pager (FEATURES C1, C7) -->

    <!-- Label of the app-bar button that scrolls the pager back to the month containing today. Shown
         only while another month is on screen. Reused, unchanged, by the Year overview's own "Today"
         action (FEATURES C7). -->
    <string name="month_today">Today</string>

    <!-- App-bar action that opens the jump-to-date dialog (FEATURES C7). -->
    <string name="month_jump_to_date">Jump to date</string>
    <!-- Title of the dialog that asks which calendar to pick the target date in. -->
    <string name="month_jump_choose_calendar_title">Choose a calendar</string>
    <!-- Option that opens the Gregorian date picker. -->
    <string name="month_jump_pick_gregorian">Pick a Gregorian date</string>
    <!-- Option that opens the IFC date picker. -->
    <string name="month_jump_pick_ifc">Pick an IFC date</string>
    <!-- Confirm button of the IFC date picker dialog used to jump to a date. -->
    <string name="month_jump_confirm">Jump</string>
    <!-- Dismiss button shared by the jump-to-date dialogs. -->
    <string name="month_jump_cancel">Cancel</string>

    <!-- Content description folded into the app-bar title control's merged description (`docs/design-plan.md`
         §4.2, owner note 4): the title is itself a tappable pill that zooms out to the Year view. -->
    <string name="month_show_year">Show year</string>

    <!-- The day card below the grid (`docs/design-plan.md` §4.2, owner note 2; the day-card merge: this
         is now the whole day detail, not a summary onward to a popup). -->
    <string name="month_summary_holidays_empty">No holidays on this day.</string>
    <string name="month_summary_events_empty">No events on this day.</string>
    <!-- Shown before the first date tick, when there is no selected or "today" date to show yet. -->
    <string name="month_summary_loading">Loading…</string>

    <!-- Year overview (FEATURES C6, C7) -->

    <!-- Spoken description of the app-bar action that shows the year before the one on screen. -->
    <string name="year_previous">Previous year</string>
    <!-- Spoken description of the app-bar action that shows the year after the one on screen. -->
    <string name="year_next">Next year</string>

    <!-- Holiday names (FEATURES H2, H3) -->

    <!-- A holiday shown on the weekday it is observed on instead of its real date, e.g. a Saturday
         holiday observed on the Friday before. %1$s = the holiday's name. -->
    <string name="holiday_observed">%1$s (observed)</string>

    <!-- Placed between holiday names when one day has several, e.g. "Year Day, New Year’s Eve".
           is a space; keep a separator that works between names in your language. -->
    <string name="holiday_list_separator">, </string>

    <!-- The day card (FEATURES C5): the merged day detail below the Month grid (or, at expanded
         widths, beside it) — see docs/design-plan.md §4.2, owner note 2. -->

    <!-- The Gregorian equivalent of the shown IFC date, labelled so it is never confused with the IFC
         date above it. %1$s = the full Gregorian date with its weekday, e.g. "Thursday, December 31, 2026". -->
    <string name="day_gregorian">Gregorian: %1$s</string>

    <!-- Joins the day-and-week text with the quarter on one line.
         %1$s = "Day 260 · Week 38 of 52", %2$s = "Q3". -->
    <string name="day_day_week_quarter">%1$s · %2$s</string>

    <!-- Badge shown on the day card when the shown day is the real today. -->
    <string name="day_today">Today</string>

    <!-- Heading above the list of holidays that fall on the shown day. Not shown when there are none. -->
    <string name="day_holidays">Holidays</string>

    <!-- Agenda (FEATURES C5, T5): the day's or today's events, shared between the day card and the
         Today screen. -->

    <!-- Heading above the list of the day's events on the day card. Not shown when there are none. -->
    <string name="day_events">Events</string>

    <!-- Action that opens the event editor pre-filled with the shown day. -->
    <string name="day_add_event">Add event</string>

    <!-- Action that opens the converter pre-filled with the shown day (FEATURES D1). -->
    <string name="day_open_in_converter">Open in converter</string>

    <!-- Deleting an agenda row (FEATURES E1): a recurring row offers "delete this occurrence" (with
         undo), a non-recurring one a plain, permanent delete. -->

    <!-- Confirmation dialog for a recurring row. -->
    <string name="day_delete_occurrence_title">Delete this occurrence?</string>
    <string name="day_delete_occurrence_text">Only this date is removed. You can undo it from the message that appears next.</string>
    <string name="day_delete_occurrence_action">Delete this occurrence</string>

    <!-- Confirmation dialog for a non-recurring row. -->
    <string name="day_delete_event_title">Delete event?</string>
    <string name="day_delete_event_text">This deletes the whole event. This can\'t be undone.</string>
    <string name="day_delete_event_action">Delete event</string>

    <string name="day_delete_cancel">Cancel</string>

    <!-- Snackbar after "delete this occurrence", with its undo action. -->
    <string name="day_delete_occurrence_snackbar">This occurrence was deleted.</string>
    <string name="day_delete_occurrence_undo">Undo</string>

    <!-- Placeholder shown instead of an event's title when the user left it blank. -->
    <string name="agenda_untitled_event">(No title)</string>

    <!-- Shown instead of a time range for an all-day event. -->
    <string name="agenda_all_day">All day</string>

    <!-- A timed event's start and end time of day, already locale-formatted.
         %1$s = start, e.g. "9:30 AM"; %2$s = end, e.g. "10:15 AM". -->
    <string name="agenda_time_range">%1$s–%2$s</string>

    <!-- Heading above today's own events on the Today screen. Not shown when there are none. -->
    <string name="today_agenda_heading">Today’s events</string>

    <!-- Heading above today's holidays on the Today screen. Not shown when there are none. -->
    <string name="today_holidays">Holidays</string>

    <!-- The next upcoming holiday from an enabled pack (FEATURES T5), a countdown in the same shape as
         the intercalary-day one. %1$d = the number of days from today; %2$s = the holiday's name. -->
    <plurals name="today_next_holiday">
        <item quantity="one">%1$d day until %2$s</item>
        <item quantity="other">%1$d days until %2$s</item>
    </plurals>

</resources>
