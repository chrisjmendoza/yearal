<?xml version="1.0" encoding="utf-8"?>
<!--
  Static widget-picker preview for the Month widget (ROADMAP M5 T5; `res/xml-v31/month_widget_info.xml`'s
  `previewLayout`, API 31-34; superseded on API 35+ by `MonthGlanceWidget.providePreview` +
  `WidgetPreviewUpdater`'s `setWidgetPreview` call, docs/ARCHITECTURE.md §5 "Picker previews").

  A plain RemoteViews-safe layout (LinearLayout + TextView only), shown by the launcher's picker before
  the widget is placed, so it cannot run MonthGlanceWidget's own code: every value is a fixed sample
  (September 2026, today = IFC day 8 = Gregorian September 17, the exact date hand-checked in
  MonthWidgetStateTest, real-world Thursday). September has no trailing Leap Day / Year Day band, so
  nothing here can misrepresent one (CLAUDE.md rule 6's concern for a *static* mock-up, same reasoning as
  the Today preview). Day 8 (today) and day 21 (illustrative only, not real data) carry the event-dot
  glyph, and days 15 and 21 the holiday diamond, to show both kinds of mark; day numbers are plain
  digits, not language content, so
  `tools:ignore="HardcodedText"` applies to them alone (CLAUDE.md rule 9 covers translatable text; digits
  are not that).

  Each day cell carries the IFC day, then the Gregorian day beneath it, then the event dot, as separate
  lines of one TextView, the same three lines MonthGlanceWidget's own cell stacks at its larger size.
  One TextView rather than a nested layout per cell keeps this inside RemoteViews' view budget; the one
  visible consequence is that the "today" pill background covers the whole cell here, where the real
  widget draws it around the IFC number alone. This mock-up also leaves out the real widget's grid rule
  lines, which come from a cell background painted inside a 1dp inset and would fight that pill here;
  a picker thumbnail does not need them. September 2026 runs Gregorian Sep 10 - Oct 7, so IFC day 1
  is Gregorian September 10 and IFC day 8 (today) is September 17.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_preview_background"
    android:padding="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="start"
        android:text="@string/widget_preview_month_title"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/widget_preview_on_surface" />

    <!-- The month's Gregorian span, directly under the title it belongs to. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:text="@string/widget_preview_month_gregorian_span"
        android:textSize="11sp"
        android:textColor="@color/widget_preview_on_surface_variant" />

    <!-- Nominal IFC weekday header row. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView style="@style/WidgetPreviewHeaderCell" android:text="@string/widget_preview_nominal_weekday_1" />
        <TextView style="@style/WidgetPreviewHeaderCell" android:text="@string/widget_preview_nominal_weekday_2" />
        <TextView style="@style/WidgetPreviewHeaderCell" android:text="@string/widget_preview_nominal_weekday_3" />
        <TextView style="@style/WidgetPreviewHeaderCell" android:text="@string/widget_preview_nominal_weekday_4" />
        <TextView style="@style/WidgetPreviewHeaderCell" android:text="@string/widget_preview_nominal_weekday_5" />
        <TextView style="@style/WidgetPreviewHeaderCell" android:text="@string/widget_preview_nominal_weekday_6" />
        <TextView style="@style/WidgetPreviewHeaderCell" android:text="@string/widget_preview_nominal_weekday_7" />
    </LinearLayout>

    <!-- Actual real-world weekday header row (never derived from the nominal row, calendar-spec §4.1). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView style="@style/WidgetPreviewHeaderCellVariant" android:text="@string/widget_preview_actual_weekday_1" />
        <TextView style="@style/WidgetPreviewHeaderCellVariant" android:text="@string/widget_preview_actual_weekday_2" />
        <TextView style="@style/WidgetPreviewHeaderCellVariant" android:text="@string/widget_preview_actual_weekday_3" />
        <TextView style="@style/WidgetPreviewHeaderCellVariant" android:text="@string/widget_preview_actual_weekday_4" />
        <TextView style="@style/WidgetPreviewHeaderCellVariant" android:text="@string/widget_preview_actual_weekday_5" />
        <TextView style="@style/WidgetPreviewHeaderCellVariant" android:text="@string/widget_preview_actual_weekday_6" />
        <TextView style="@style/WidgetPreviewHeaderCellVariant" android:text="@string/widget_preview_actual_weekday_7" />
    </LinearLayout>

    <!-- 4x7 day-number grid. Day 8 is "today" (the pill background); days 8 and 21 carry the
         illustrative event dot (a mock-up value, not real data; ROADMAP M5 T6). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView style="@style/WidgetPreviewDayCell" android:text="1\n10" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="2\n11" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="3\n12" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="4\n13" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="5\n14" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="6\n15" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="7\n16" tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView style="@style/WidgetPreviewDayCellToday" android:text="8\n17\n•" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="9\n18" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="10\n19" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="11\n20" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="12\n21" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="13\n22" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="14\n23" tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView style="@style/WidgetPreviewDayCell" android:text="15\n24\n◆" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="16\n25" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="17\n26" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="18\n27" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="19\n28" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="20\n29" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="21\n30\n◆•" tools:ignore="HardcodedText" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView style="@style/WidgetPreviewDayCell" android:text="22\n1" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="23\n2" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="24\n3" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="25\n4" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="26\n5" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="27\n6" tools:ignore="HardcodedText" />
        <TextView style="@style/WidgetPreviewDayCell" android:text="28\n7" tools:ignore="HardcodedText" />
    </LinearLayout>

</LinearLayout>
