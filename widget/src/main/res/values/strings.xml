<?xml version="1.0" encoding="utf-8"?>
<!-- Every user- or TalkBack-visible widget string lives here (CLAUDE.md rule 9). -->
<resources>
    <!-- Widget-picker label (android:label on the receiver) and the provider's picker description. -->
    <string name="today_widget_label">Today (IFC)</string>
    <string name="today_widget_description">Today\'s International Fixed Calendar date, the Gregorian date and weekday. Updates automatically at midnight.</string>

    <!-- Content description of the initial/preview layout's progress indicator. -->
    <string name="today_widget_loading">Loading today’s date</string>

    <!-- Appended to the merged content description so TalkBack announces that the widget is tappable.
         Shared by the Month widget (ROADMAP M5 T3): the hint is not Today-specific wording. -->
    <string name="today_widget_tap_hint">Double-tap to open Yearal.</string>

    <!-- The LARGE-size Today widget's year-progress line (design-plan §4.9, "large widgets should show
         more"): day of year, the year's length (365 or 366), and the rounded percent, e.g.
         "Day 260 of 365 · 71%". %% escapes a literal percent sign. -->
    <string name="today_widget_year_progress">Day %1$d of %2$d · %3$d%%</string>

    <!-- The bare intercalary day names, without a year, for the countdown line below: distinct from
         `:core:designsystem`'s own copies of these words (CLAUDE.md rule 9: every module's user-visible
         strings live in its own resources). -->
    <string name="today_widget_leap_day">Leap Day</string>
    <string name="today_widget_year_day">Year Day</string>

    <!-- The LARGE-size Today widget's next-intercalary countdown, e.g. "Year Day in 105 days",
         "Leap Day in 1 day". %1$s is one of the two names above. -->
    <plurals name="today_widget_intercalary_countdown">
        <item quantity="one">%1$s in 1 day</item>
        <item quantity="other">%1$s in %2$d days</item>
    </plurals>

    <!-- Month-grid widget (ROADMAP M5 T3). Widget-picker label and the provider's picker description. -->
    <string name="month_widget_label">Month (IFC)</string>
    <string name="month_widget_description">The current International Fixed Calendar month, with today highlighted. Updates automatically at midnight.</string>

    <!-- Content description of the Month widget's initial/preview layout progress indicator. -->
    <string name="month_widget_loading">Loading the current IFC month</string>

    <!-- Appended to the Month widget's merged content description when today has at least one event
         (ROADMAP M5 T6). Reveals only that something exists, never a title or a count (CLAUDE.md rule 8). -->
    <string name="month_widget_has_events_hint">Has events.</string>

    <!-- Widget-picker preview content (ROADMAP M5 T5): a fixed, illustrative sample date, never live
         data (`res/layout/today_widget_preview.xml`, `res/layout/month_widget_preview.xml`). The sample
         is a regular day on purpose (CLAUDE.md rule 6: a static mock-up of Year Day or Leap Day could
         misrepresent a day that exists in the app in only one form). -->
    <string name="widget_preview_today_ifc_date">Sol 13</string>
    <string name="widget_preview_today_gregorian_date">Tue, Jun 30, 2026</string>
    <string name="widget_preview_today_actual_weekday">Actual weekday: Tuesday</string>
    <string name="widget_preview_month_title">September 2026</string>
    <string name="widget_preview_month_gregorian_span">Sep 10 – Oct 7</string>

    <!-- The nominal IFC weekday header, fixed in every month and year (calendar-spec §2.3, R6). Plain
         strings, not a `string-array`, since a static preview layout's `android:text` cannot index into
         an array without code. -->
    <string name="widget_preview_nominal_weekday_1">Sun</string>
    <string name="widget_preview_nominal_weekday_2">Mon</string>
    <string name="widget_preview_nominal_weekday_3">Tue</string>
    <string name="widget_preview_nominal_weekday_4">Wed</string>
    <string name="widget_preview_nominal_weekday_5">Thu</string>
    <string name="widget_preview_nominal_weekday_6">Fri</string>
    <string name="widget_preview_nominal_weekday_7">Sat</string>

    <!-- September 2026's IFC day 1 (nominal Sunday) is real-world Thursday, hand-checked the same way
         as MonthWidgetStateTest; a common year, so every month before Leap Day shares this rotation. -->
    <string name="widget_preview_actual_weekday_1">Thu</string>
    <string name="widget_preview_actual_weekday_2">Fri</string>
    <string name="widget_preview_actual_weekday_3">Sat</string>
    <string name="widget_preview_actual_weekday_4">Sun</string>
    <string name="widget_preview_actual_weekday_5">Mon</string>
    <string name="widget_preview_actual_weekday_6">Tue</string>
    <string name="widget_preview_actual_weekday_7">Wed</string>
</resources>
